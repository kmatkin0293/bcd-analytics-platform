liveboard:
  name: Out-of-Policy Bookings Analytics (v2 draft)
  description: "Comprehensive analytics on out-of-policy travel bookings — compliance rates, root cause drivers, and financial impact across departments, travel types, and suppliers."
  visualizations:
  - id: Viz_1
    answer:
      name: Out-of-Policy Avg Booking Days
      description: Monthly average advance booking days trends
      tables:
      - id: BCD Travel Analytics
        name: BCD Travel Analytics
        obj_id: BCDTravelAnalytics-1a0d5e30
      search_query: "average [Advance Booking Days] [Booking Date].monthly [Out of Policy Flag] = 1 [Booking Date] = 'last 18 months'"
      answer_columns:
      - name: Average Advance Booking Days
      - name: Month(Booking Date)
      table:
        table_columns:
        - column_id: Average Advance Booking Days
          show_headline: false
        - column_id: Month(Booking Date)
          show_headline: false
        ordered_column_ids:
        - Month(Booking Date)
        - Average Advance Booking Days
        client_state: ""
      chart:
        type: KPI
        chart_columns:
        - column_id: Average Advance Booking Days
        - column_id: Month(Booking Date)
        axis_configs:
        - x:
          - Month(Booking Date)
          "y":
          - Average Advance Booking Days
        client_state: ""
        viz_style: "{\"overrides\": {\"column_properties\": [{\"column_id\": \"Average Advance Booking Days\",\"properties\": {\"color\": \"#ce0e2d\"}}]}}"
      display_mode: CHART_MODE
  - id: Viz_2
    answer:
      name: Out-of-Policy Hotel Rate Trend
      description: "Monthly average nightly rate, out-of-policy."
      tables:
      - id: BCD Travel Analytics
        name: BCD Travel Analytics
        obj_id: BCDTravelAnalytics-1a0d5e30
      search_query: "average [Hotel Nightly Rate (GBP)] [Booking Date].monthly [Out of Policy Flag] = 1 [Booking Date] = 'last 18 months' [Travel Type] = 'hotel'"
      answer_columns:
      - name: Average Hotel Nightly Rate (GBP)
      - name: Month(Booking Date)
      table:
        table_columns:
        - column_id: Average Hotel Nightly Rate (GBP)
          show_headline: false
        - column_id: Month(Booking Date)
          show_headline: false
        ordered_column_ids:
        - Month(Booking Date)
        - Average Hotel Nightly Rate (GBP)
        client_state: ""
      chart:
        type: KPI
        chart_columns:
        - column_id: Average Hotel Nightly Rate (GBP)
        - column_id: Month(Booking Date)
        axis_configs:
        - x:
          - Month(Booking Date)
          "y":
          - Average Hotel Nightly Rate (GBP)
        client_state: ""
        viz_style: "{\"overrides\": {\"column_properties\": [{\"column_id\": \"Average Hotel Nightly Rate (GBP)\",\"properties\": {\"color\": \"#ce0e2d\"}}]}}"
      display_mode: CHART_MODE
  - id: Viz_3
    answer:
      name: Out-of-Policy Air Bookings by Cabin
      description: "Policy violations by cabin class, 18mo"
      tables:
      - id: BCD Travel Analytics
        name: BCD Travel Analytics
        obj_id: BCDTravelAnalytics-1a0d5e30
      search_query: "unique count [Booking ID] [Cabin Class] [Out of Policy Flag] = 1 [Booking Date] = 'last 18 months' [Travel Type] = 'air'"
      answer_columns:
      - name: Cabin Class
      - name: Unique Number of Booking ID
        format:
          category: NUMBER
          numberFormatConfig:
            unit: NONE
            decimals: 0.0
            toSeparateThousands: true
            removeTrailingZeroes: true
          isCategoryEditable: true
      table:
        table_columns:
        - column_id: Cabin Class
          show_headline: false
        - column_id: Unique Number of Booking ID
          show_headline: false
        ordered_column_ids:
        - Cabin Class
        - Unique Number of Booking ID
        client_state: ""
      chart:
        type: ADVANCED_BAR
        chart_columns:
        - column_id: Cabin Class
        - column_id: Unique Number of Booking ID
        client_state: ""
        custom_chart_config:
        - key: basic
          dimensions:
          - key: y-axis
            axes:
            - type: FLAT
              column: Cabin Class
            mode: AXIS_DRIVEN
          - key: x-axis
            axes:
            - type: FLAT
              column: Unique Number of Booking ID
            mode: AXIS_DRIVEN
          - key: slice-with-color
            mode: AXIS_DRIVEN
          - key: trellis-by
            mode: AXIS_DRIVEN
        viz_style: "{\"overrides\": {\"legend_properties\": {\"show_legend\": false},\"data_label_properties\": {\"all_labels\": true},\"display_properties\": {\"gridline_properties\": {\"x_gridline_enabled\": false,\"y_gridline_enabled\": false}},\"axis_properties\": [{\"linked_columns\": [\"Unique Number of Booking ID\"],\"properties\": {\"is_name_visible\": false,\"is_label_visible\": true}},{\"linked_columns\": [\"Cabin Class\"],\"properties\": {\"is_name_visible\": false,\"is_label_visible\": true}}],\"column_properties\": [{\"column_id\": \"Unique Number of Booking ID\",\"properties\": {\"color\": \"#ce0e2d\"}}]}}"
      display_mode: CHART_MODE
  - id: Viz_4
    answer:
      name: Out-of-Policy Bookings by Channel
      description: "OOP booking amounts by channel, 18M"
      tables:
      - id: BCD Travel Analytics
        name: BCD Travel Analytics
        obj_id: BCDTravelAnalytics-1a0d5e30
      search_query: "sum [Booking Amount (GBP)] [Booking Channel] [Out of Policy Flag] = 1 [Booking Date] = 'last 18 months'"
      answer_columns:
      - name: Booking Channel
      - name: Total Booking Amount (GBP)
        format:
          category: CURRENCY
          currencyFormatConfig:
            locale: GBP
            unit: MILLION
            decimals: 0.0
            toSeparateThousands: true
            removeTrailingZeroes: true
          isCategoryEditable: true
      table:
        table_columns:
        - column_id: Booking Channel
          show_headline: false
        - column_id: Total Booking Amount (GBP)
          show_headline: false
        ordered_column_ids:
        - Booking Channel
        - Total Booking Amount (GBP)
        client_state: ""
      chart:
        type: ADVANCED_COLUMN
        chart_columns:
        - column_id: Booking Channel
        - column_id: Total Booking Amount (GBP)
        client_state: ""
        custom_chart_config:
        - key: basic
          dimensions:
          - key: x-axis
            axes:
            - type: FLAT
              column: Booking Channel
            mode: AXIS_DRIVEN
          - key: y-axis
            axes:
            - type: FLAT
              column: Total Booking Amount (GBP)
            mode: AXIS_DRIVEN
          - key: slice-with-color
            mode: AXIS_DRIVEN
          - key: trellis-by
            mode: AXIS_DRIVEN
        viz_style: "{\"overrides\": {\"legend_properties\": {\"show_legend\": false},\"data_label_properties\": {\"all_labels\": true},\"display_properties\": {\"gridline_properties\": {\"x_gridline_enabled\": false,\"y_gridline_enabled\": false}},\"axis_properties\": [{\"linked_columns\": [\"Total Booking Amount (GBP)\"],\"properties\": {\"is_name_visible\": false,\"is_label_visible\": true}},{\"linked_columns\": [\"Booking Channel\"],\"properties\": {\"is_name_visible\": false,\"is_label_visible\": true}}],\"column_properties\": [{\"column_id\": \"Total Booking Amount (GBP)\",\"properties\": {\"color\": \"#ce0e2d\"}}]}}"
      display_mode: CHART_MODE
  - id: Viz_5
    answer:
      name: Out-of-Policy Booking Analysis
      description: Advance days vs amount by department.
      tables:
      - id: BCD Travel Analytics
        name: BCD Travel Analytics
        obj_id: BCDTravelAnalytics-1a0d5e30
      search_query: "average [Advance Booking Days] average [Booking Amount (GBP)] [Traveller Department] [Out of Policy Flag] = 1 [Booking Date] = 'last 18 months'"
      answer_columns:
      - name: Average Advance Booking Days
      - name: Average Booking Amount (GBP)
      - name: Traveller Department
      table:
        table_columns:
        - column_id: Average Advance Booking Days
          show_headline: false
        - column_id: Average Booking Amount (GBP)
          show_headline: false
        - column_id: Traveller Department
          show_headline: false
        ordered_column_ids:
        - Traveller Department
        - Average Advance Booking Days
        - Average Booking Amount (GBP)
        client_state: ""
      chart:
        type: ADVANCED_SCATTER
        chart_columns:
        - column_id: Average Advance Booking Days
        - column_id: Average Booking Amount (GBP)
        - column_id: Traveller Department
        client_state: ""
        custom_chart_config:
        - key: basic
          dimensions:
          - key: x-axis
            axes:
            - type: FLAT
              column: Traveller Department
            mode: AXIS_DRIVEN
          - key: y-axis
            axes:
            - type: MERGED
              columns:
              - Average Advance Booking Days
              - Average Booking Amount (GBP)
            mode: AXIS_DRIVEN
          - key: slice-with-color
            mode: AXIS_DRIVEN
          - key: trellis-by
            mode: AXIS_DRIVEN
        viz_style: "{\"overrides\": {\"display_properties\": {\"gridline_properties\": {\"x_gridline_enabled\": false,\"y_gridline_enabled\": false}},\"column_properties\": [{\"column_id\": \"Average Booking Amount (GBP)\",\"properties\": {\"color\": \"#ce0e2d\"}}]}}"
      display_mode: CHART_MODE
  - id: Viz_6
    answer:
      name: Top Out-of-Policy Booking Reasons
      description: Policy violations by reason and travel.
      tables:
      - id: BCD Travel Analytics
        name: BCD Travel Analytics
        obj_id: BCDTravelAnalytics-1a0d5e30
      search_query: "top 8 [Out of Policy Reason] [Travel Type] count [Booking ID] [Out of Policy Flag] = 1 [Booking Date] = 'last 18 months' sort by count [Booking ID]"
      answer_columns:
      - name: Number of Booking ID
      - name: Out of Policy Reason
      - name: Travel Type
      table:
        table_columns:
        - column_id: Number of Booking ID
          show_headline: false
        - column_id: Out of Policy Reason
          show_headline: false
        - column_id: Travel Type
          show_headline: false
        ordered_column_ids:
        - Out of Policy Reason
        - Travel Type
        - Number of Booking ID
        client_state: ""
      chart:
        type: ADVANCED_STACKED_BAR
        chart_columns:
        - column_id: Number of Booking ID
        - column_id: Out of Policy Reason
        - column_id: Travel Type
        client_state: ""
        custom_chart_config:
        - key: basic
          dimensions:
          - key: x-axis
            axes:
            - type: FLAT
              column: Number of Booking ID
            mode: AXIS_DRIVEN
          - key: y-axis
            axes:
            - type: FLAT
              column: Out of Policy Reason
            mode: AXIS_DRIVEN
          - key: slice-with-color
            mode: AXIS_DRIVEN
          - key: trellis-by
            mode: AXIS_DRIVEN
        viz_style: "{\"overrides\": {\"legend_properties\": {\"show_legend\": true,\"position\": \"BOTTOM_LEGEND\",\"color_palette\": {\"colors\": [\"#f7c8cf\",\"#f0939f\",\"#ce0e2d\",\"#9a0a22\",\"#6b0618\",\"#fad4bc\",\"#f0a882\",\"#c96a3a\",\"#8f4a28\",\"#5e2e15\",\"#e8d0d8\",\"#d4a0b0\",\"#a86080\",\"#7a3d5a\",\"#4d2238\",\"#dcdcdc\",\"#c0c0c0\",\"#8b8b8b\",\"#5a5a5a\",\"#2d2d2d\",\"#d4d8dc\",\"#b0b8c0\",\"#6b7280\",\"#48535e\",\"#2c3540\",\"#f2d8dc\",\"#e0a8b2\",\"#c07080\",\"#8a4855\",\"#563038\",\"#f8e0e8\",\"#edb8cc\",\"#d080a8\",\"#a05078\",\"#6a2848\",\"#f5e8d0\",\"#e8c888\",\"#c89040\",\"#8a6028\",\"#4e3810\"]}},\"data_label_properties\": {\"stack_labels_properties\": {\"is_visible\": true},\"column_data_label_properties\": [{\"column_id\": \"Number of Booking ID\",\"properties\": {\"is_visible\": false}}]},\"display_properties\": {\"gridline_properties\": {\"x_gridline_enabled\": false,\"y_gridline_enabled\": false}}}}"
      display_mode: CHART_MODE
  - id: Viz_7
    answer:
      name: Out-of-Policy Bookings by Seniority
      description: Monthly out-of-policy booking percentage trends
      tables:
      - id: BCD Travel Analytics
        name: BCD Travel Analytics
        obj_id: BCDTravelAnalytics-1a0d5e30
      formulas:
      - id: formula_OOP Rate
        name: OOP Rate
        expr: "sum ( if ( [Out of Policy Flag] = 1 ) then 1 else 0 ) / count ( [Booking ID] ) * 100"
        was_auto_generated: false
      search_query: "[formula_OOP Rate] [Booking Date].monthly [Traveller Seniority] [Booking Date] = 'last 18 months'"
      answer_columns:
      - name: Month(Booking Date)
      - name: OOP Rate
        format:
          category: PERCENTAGE
          percentageFormatConfig:
            decimals: 1.0
            removeTrailingZeroes: false
          isCategoryEditable: true
      - name: Traveller Seniority
      table:
        table_columns:
        - column_id: Month(Booking Date)
          show_headline: false
        - column_id: OOP Rate
          show_headline: false
        - column_id: Traveller Seniority
          show_headline: false
        ordered_column_ids:
        - Month(Booking Date)
        - Traveller Seniority
        - OOP Rate
        client_state: ""
        viz_style: "{\"overrides\": {\"column_properties\": [{\"columnId\": \"OOP Rate\",\"columnProperty\": {\"conditionalFormatting\": {\"rows\": [{\"operator\": \"GREATER_THAN_EQUAL_TO\",\"value\": \"0.12\",\"fontProperties\": {\"color\": \"#6B0618\",\"bold\": true},\"backgroundFormatType\": \"SOLID\",\"solidBackgroundAttrs\": {\"color\": \"#F7C8CF\"},\"comparisonType\": \"VALUE_BASED\",\"lhsColumnId\": \"OOP Rate\"},{\"operator\": \"GREATER_THAN_EQUAL_TO\",\"value\": \"0.13\",\"fontProperties\": {\"color\": \"#6B0618\",\"bold\": true},\"backgroundFormatType\": \"SOLID\",\"solidBackgroundAttrs\": {\"color\": \"#F0939F\"},\"comparisonType\": \"VALUE_BASED\",\"lhsColumnId\": \"OOP Rate\"}]}}}],\"display_properties\": {\"table_theme\": \"ZEBRA\",\"table_content_density\": \"COMPACT\"}}}"
      chart:
        type: ADVANCED_LINE
        chart_columns:
        - column_id: Month(Booking Date)
        - column_id: OOP Rate
        - column_id: Traveller Seniority
        client_state: ""
        custom_chart_config:
        - key: basic
          dimensions:
          - key: x-axis
            axes:
            - type: FLAT
              column: Month(Booking Date)
            mode: AXIS_DRIVEN
          - key: y-axis
            axes:
            - type: FLAT
              column: OOP Rate
            mode: AXIS_DRIVEN
          - key: slice-with-color
            mode: AXIS_DRIVEN
          - key: trellis-by
            mode: AXIS_DRIVEN
      display_mode: TABLE_MODE
  - id: Viz_8
    answer:
      name: Monthly Out-of-Policy Bookings
      description: Out-of-policy booking amounts over 18 months.
      tables:
      - id: BCD Travel Analytics
        name: BCD Travel Analytics
        obj_id: BCDTravelAnalytics-1a0d5e30
      search_query: "[Booking Amount (GBP)] [Booking Date].monthly [Out of Policy Flag] = 1 [Booking Date] = 'last 18 months'"
      answer_columns:
      - name: Month(Booking Date)
      - name: Total Booking Amount (GBP)
      table:
        table_columns:
        - column_id: Month(Booking Date)
          show_headline: false
        - column_id: Total Booking Amount (GBP)
          show_headline: false
        ordered_column_ids:
        - Month(Booking Date)
        - Total Booking Amount (GBP)
        client_state: ""
      chart:
        type: KPI
        chart_columns:
        - column_id: Month(Booking Date)
        - column_id: Total Booking Amount (GBP)
        axis_configs:
        - x:
          - Month(Booking Date)
          "y":
          - Total Booking Amount (GBP)
        client_state: ""
        viz_style: "{\"overrides\": {\"column_properties\": [{\"column_id\": \"Total Booking Amount (GBP)\",\"properties\": {\"color\": \"#ce0e2d\"}}]}}"
      display_mode: CHART_MODE
  - id: Viz_9
    answer:
      name: Out-of-Policy Savings Monthly Trend
      description: Monthly out-of-policy savings over 18 months.
      tables:
      - id: BCD Travel Analytics
        name: BCD Travel Analytics
        obj_id: BCDTravelAnalytics-1a0d5e30
      search_query: "sum [Savings Amount (GBP)] [Booking Date].monthly [Out of Policy Flag] = 1 [Booking Date] = 'last 18 months'"
      answer_columns:
      - name: Month(Booking Date)
      - name: Total Savings Amount (GBP)
      table:
        table_columns:
        - column_id: Month(Booking Date)
          show_headline: false
        - column_id: Total Savings Amount (GBP)
          show_headline: false
        ordered_column_ids:
        - Month(Booking Date)
        - Total Savings Amount (GBP)
        client_state: ""
      chart:
        type: KPI
        chart_columns:
        - column_id: Month(Booking Date)
        - column_id: Total Savings Amount (GBP)
        axis_configs:
        - x:
          - Month(Booking Date)
          "y":
          - Total Savings Amount (GBP)
        client_state: ""
        viz_style: "{\"overrides\": {\"column_properties\": [{\"column_id\": \"Total Savings Amount (GBP)\",\"properties\": {\"color\": \"#ce0e2d\"}}]}}"
      display_mode: CHART_MODE
  - id: Viz_10
    answer:
      name: Monthly Booking & OOP Rate
      description: Booking amount and OOP rate trends.
      tables:
      - id: BCD Travel Analytics
        name: BCD Travel Analytics
        obj_id: BCDTravelAnalytics-1a0d5e30
      formulas:
      - id: formula_Percentage OOP Rate
        name: Percentage OOP Rate
        expr: "( count ( if ( [Out of Policy Flag] = 1 ) then [Booking ID] else 0 ) ) / count ( [Booking ID] ) * 100"
        was_auto_generated: false
      search_query: "[Booking Amount (GBP)] [formula_Percentage OOP Rate] [Booking Date].monthly [Booking Date] = 'last 18 months'"
      answer_columns:
      - name: Month(Booking Date)
      - name: Percentage OOP Rate
      - name: Total Booking Amount (GBP)
        format:
          category: CURRENCY
          currencyFormatConfig:
            locale: GBP
            unit: MILLION
            decimals: 1.0
            toSeparateThousands: true
            removeTrailingZeroes: true
          isCategoryEditable: true
      table:
        table_columns:
        - column_id: Month(Booking Date)
          show_headline: false
        - column_id: Percentage OOP Rate
          show_headline: false
        - column_id: Total Booking Amount (GBP)
          show_headline: false
        ordered_column_ids:
        - Month(Booking Date)
        - Total Booking Amount (GBP)
        - Percentage OOP Rate
        client_state: ""
      chart:
        type: ADVANCED_LINE_COLUMN
        chart_columns:
        - column_id: Month(Booking Date)
        - column_id: Percentage OOP Rate
        - column_id: Total Booking Amount (GBP)
        client_state: ""
        custom_chart_config:
        - key: basic
          dimensions:
          - key: x-axis
            axes:
            - type: FLAT
              column: Month(Booking Date)
            mode: AXIS_DRIVEN
          - key: y-axis-column
            axes:
            - type: MERGED
              columns:
              - Total Booking Amount (GBP)
            mode: AXIS_DRIVEN
          - key: y-axis-line
            axes:
            - type: MERGED
              columns:
              - Percentage OOP Rate
            mode: AXIS_DRIVEN
          - key: trellis-by
            mode: AXIS_DRIVEN
        viz_style: "{\"overrides\": {\"legend_properties\": {\"show_legend\": true,\"position\": \"BOTTOM_LEGEND\"},\"data_label_properties\": {\"all_labels\": true},\"display_properties\": {\"gridline_properties\": {\"x_gridline_enabled\": false,\"y_gridline_enabled\": false}},\"axis_properties\": [{\"linked_columns\": [\"Total Booking Amount (GBP)\"],\"properties\": {\"is_name_visible\": false,\"is_label_visible\": true}},{\"linked_columns\": [\"Percentage OOP Rate\"],\"properties\": {\"is_name_visible\": false,\"is_label_visible\": true}}],\"column_properties\": [{\"column_id\": \"Total Booking Amount (GBP)\",\"properties\": {\"color\": \"#ce0e2d\"}},{\"column_id\": \"Percentage OOP Rate\",\"properties\": {\"color\": \"#2d2d2d\"}}]}}"
      display_mode: CHART_MODE
  - id: Viz_11
    answer:
      name: Top 10 Out-of-Policy Suppliers
      description: Highest booking amounts by supplier name.
      tables:
      - id: BCD Travel Analytics
        name: BCD Travel Analytics
        obj_id: BCDTravelAnalytics-1a0d5e30
      search_query: "top 10 [Supplier Name] [Out of Policy Flag] = 1 [Booking Date] = 'last 18 months' sort by [Booking Amount (GBP)]"
      answer_columns:
      - name: Supplier Name
      - name: Total Booking Amount (GBP)
        format:
          category: CURRENCY
          currencyFormatConfig:
            locale: GBP
            unit: THOUSANDS
            decimals: 0.0
            toSeparateThousands: true
            removeTrailingZeroes: true
          isCategoryEditable: true
      table:
        table_columns:
        - column_id: Supplier Name
          show_headline: false
        - column_id: Total Booking Amount (GBP)
          show_headline: false
        ordered_column_ids:
        - Supplier Name
        - Total Booking Amount (GBP)
        client_state: ""
      chart:
        type: ADVANCED_BAR
        chart_columns:
        - column_id: Supplier Name
        - column_id: Total Booking Amount (GBP)
        client_state: ""
        custom_chart_config:
        - key: basic
          dimensions:
          - key: x-axis
            axes:
            - type: FLAT
              column: Total Booking Amount (GBP)
            mode: AXIS_DRIVEN
          - key: y-axis
            axes:
            - type: FLAT
              column: Supplier Name
            mode: AXIS_DRIVEN
          - key: slice-with-color
            mode: AXIS_DRIVEN
          - key: trellis-by
            mode: AXIS_DRIVEN
        viz_style: "{\"overrides\": {\"legend_properties\": {\"show_legend\": false},\"data_label_properties\": {\"all_labels\": true},\"display_properties\": {\"gridline_properties\": {\"x_gridline_enabled\": false,\"y_gridline_enabled\": false}},\"axis_properties\": [{\"linked_columns\": [\"Total Booking Amount (GBP)\"],\"properties\": {\"is_name_visible\": false,\"is_label_visible\": true}},{\"linked_columns\": [\"Supplier Name\"],\"properties\": {\"is_name_visible\": false,\"is_label_visible\": true}}],\"column_properties\": [{\"column_id\": \"Total Booking Amount (GBP)\",\"properties\": {\"color\": \"#ce0e2d\"}}]}}"
      display_mode: CHART_MODE
  - id: Viz_12
    answer:
      name: Top 10 Out-of-Policy Departments
      description: Out-of-policy bookings by department.
      tables:
      - id: BCD Travel Analytics
        name: BCD Travel Analytics
        obj_id: BCDTravelAnalytics-1a0d5e30
      search_query: "top 10 [Traveller Department] [Booking Amount (GBP)] [Out of Policy Flag] = 1 [Booking Date] = 'last 18 months' sort by [Booking Amount (GBP)]"
      answer_columns:
      - name: Total Booking Amount (GBP)
        format:
          category: CURRENCY
          currencyFormatConfig:
            locale: GBP
            unit: THOUSANDS
            decimals: 0.0
            toSeparateThousands: true
            removeTrailingZeroes: true
          isCategoryEditable: true
      - name: Traveller Department
      table:
        table_columns:
        - column_id: Total Booking Amount (GBP)
          show_headline: false
        - column_id: Traveller Department
          show_headline: false
        ordered_column_ids:
        - Traveller Department
        - Total Booking Amount (GBP)
        client_state: ""
      chart:
        type: ADVANCED_COLUMN
        chart_columns:
        - column_id: Total Booking Amount (GBP)
        - column_id: Traveller Department
        client_state: ""
        custom_chart_config:
        - key: basic
          dimensions:
          - key: y-axis
            axes:
            - type: FLAT
              column: Total Booking Amount (GBP)
            mode: AXIS_DRIVEN
          - key: x-axis
            axes:
            - type: FLAT
              column: Traveller Department
            mode: AXIS_DRIVEN
          - key: slice-with-color
            mode: AXIS_DRIVEN
