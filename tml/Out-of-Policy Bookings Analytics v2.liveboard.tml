  - id: Viz_35
    answer:
      name: Highest OOP Cost Centres
      description: "The 15 cost centres with the highest out-of-policy rate"
      tables:
      - id: BCD Travel Analytics
        name: BCD Travel Analytics
        obj_id: BCDTravelAnalytics-1a0d5e30
      search_query: "top 15 [Cost Center] [Out of Policy %] [Booking Date] = 'last 18 months'"
      answer_columns:
      - name: Cost Center
      - name: Out of Policy %
        format:
          category: PERCENTAGE
          percentageFormatConfig:
            decimals: 1.0
            removeTrailingZeroes: false
          isCategoryEditable: true
      table:
        table_columns:
        - column_id: Cost Center
          show_headline: false
        - column_id: Out of Policy %
          show_headline: false
        ordered_column_ids:
        - Cost Center
        - Out of Policy %
        client_state: ""
      chart:
        type: ADVANCED_BAR
        chart_columns:
        - column_id: Cost Center
        - column_id: Out of Policy %
        client_state: ""
        custom_chart_config:
        - key: basic
          dimensions:
          - key: y-axis
            axes:
            - type: FLAT
              column: Cost Center
            mode: AXIS_DRIVEN
          - key: x-axis
            axes:
            - type: FLAT
              column: Out of Policy %
            mode: AXIS_DRIVEN
          - key: slice-with-color
            mode: AXIS_DRIVEN
          - key: trellis-by
            mode: AXIS_DRIVEN
        viz_style: "{\"overrides\":{\"legend_properties\":{\"show_legend\":false,\"position\":\"BOTTOM_LEGEND\",\"color_palette\":{\"colors\":[\"#F04E23\"]}},\"data_label_properties\":{\"all_labels\":true},\"display_properties\":{\"gridline_properties\":{\"x_gridline_enabled\":false,\"y_gridline_enabled\":false}}}}"
      display_mode: CHART_MODE
  - id: Viz_36
    answer:
      name: ATC Cancellations by Departure Hour
      description: "Flights cancelled by air traffic control, by departure hour, next 24 hours"
      tables:
      - id: BCD Travel Analytics
        name: BCD Travel Analytics
        obj_id: BCDTravelAnalytics-1a0d5e30
      search_query: "unique count [Booking ID] [Flight Departure Ts].hourly [Is Atc Related] = 1 [Booking Status] = 'Cancelled' [Flight Departure Ts].'next 24 hours'"
      answer_columns:
      - name: Hour(Flight Departure Ts)
      - name: Unique Number of Booking ID
        format:
          category: NUMBER
          numberFormatConfig:
            unit: NONE
            decimals: 0.0
            toSeparateThousands: true
            removeTrailingZeroes: true
          isCategoryEditable: true
      table:
        table_columns:
        - column_id: Hour(Flight Departure Ts)
          show_headline: false
        - column_id: Unique Number of Booking ID
          show_headline: false
        ordered_column_ids:
        - Hour(Flight Departure Ts)
        - Unique Number of Booking ID
        client_state: ""
      chart:
        type: ADVANCED_COLUMN
        chart_columns:
        - column_id: Hour(Flight Departure Ts)
        - column_id: Unique Number of Booking ID
        client_state: ""
        custom_chart_config:
        - key: basic
          dimensions:
          - key: x-axis
            axes:
            - type: FLAT
              column: Hour(Flight Departure Ts)
            mode: AXIS_DRIVEN
          - key: y-axis
            axes:
            - type: FLAT
              column: Unique Number of Booking ID
            mode: AXIS_DRIVEN
          - key: slice-with-color
            mode: AXIS_DRIVEN
          - key: trellis-by
            mode: AXIS_DRIVEN
        viz_style: "{\"overrides\":{\"legend_properties\":{\"show_legend\":false,\"position\":\"BOTTOM_LEGEND\",\"color_palette\":{\"colors\":[\"#F04E23\"]}},\"data_label_properties\":{\"all_labels\":true},\"display_properties\":{\"gridline_properties\":{\"x_gridline_enabled\":false,\"y_gridline_enabled\":false}}}}"
      display_mode: CHART_MODE
  - id: Viz_37
    answer:
      name: Rebooking Exposure by Origin Airport
      description: "Cancelled bookings flagged for rebooking, by departure airport"
      tables:
      - id: BCD Travel Analytics
        name: BCD Travel Analytics
        obj_id: BCDTravelAnalytics-1a0d5e30
      search_query: "unique count [Booking ID] [Origin Airport Code] [Needs Rebooking Flag] = 1 [Booking Status] = 'Cancelled'"
      answer_columns:
      - name: Origin Airport Code
      - name: Unique Number of Booking ID
        format:
          category: NUMBER
          numberFormatConfig:
            unit: NONE
            decimals: 0.0
            toSeparateThousands: true
            removeTrailingZeroes: true
          isCategoryEditable: true
      table:
        table_columns:
        - column_id: Origin Airport Code
          show_headline: false
        - column_id: Unique Number of Booking ID
          show_headline: false
        ordered_column_ids:
        - Origin Airport Code
        - Unique Number of Booking ID
        client_state: ""
      chart:
        type: ADVANCED_BAR
        chart_columns:
        - column_id: Origin Airport Code
        - column_id: Unique Number of Booking ID
        client_state: ""
        custom_chart_config:
        - key: basic
          dimensions:
          - key: y-axis
            axes:
            - type: FLAT
              column: Origin Airport Code
            mode: AXIS_DRIVEN
          - key: x-axis
            axes:
            - type: FLAT
              column: Unique Number of Booking ID
            mode: AXIS_DRIVEN
          - key: slice-with-color
            mode: AXIS_DRIVEN
          - key: trellis-by
            mode: AXIS_DRIVEN
        viz_style: "{\"overrides\":{\"legend_properties\":{\"show_legend\":false,\"position\":\"BOTTOM_LEGEND\",\"color_palette\":{\"colors\":[\"#0B0052\"]}},\"data_label_properties\":{\"all_labels\":true},\"display_properties\":{\"gridline_properties\":{\"x_gridline_enabled\":false,\"y_gridline_enabled\":false}}}}"
      display_mode: CHART_MODE
