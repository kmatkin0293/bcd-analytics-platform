  - id: Viz_33
    answer:
      name: Preferred vs Non-Preferred Spend
      description: "Spend with contracted suppliers (1) against off-contract suppliers (0), by travel type"
      tables:
      - id: BCD Travel Analytics
        name: BCD Travel Analytics
        obj_id: BCDTravelAnalytics-1a0d5e30
      search_query: "[Booking Amount (GBP)] [Preferred Supplier Flag] [Travel Type] [Booking Date] = 'last 18 months'"
      answer_columns:
      - name: Travel Type
      - name: Preferred Supplier Flag
      - name: Total Booking Amount (GBP)
        format:
          category: CURRENCY
          currencyFormatConfig:
            locale: GBP
            unit: MILLION
            decimals: 1.0
            toSeparateThousands: true
            removeTrailingZeroes: true
          isCategoryEditable: true
      table:
        table_columns:
        - column_id: Travel Type
          show_headline: false
        - column_id: Preferred Supplier Flag
          show_headline: false
        - column_id: Total Booking Amount (GBP)
          show_headline: false
        ordered_column_ids:
